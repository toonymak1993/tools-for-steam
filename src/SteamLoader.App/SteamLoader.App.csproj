<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ToolsForSteam</AssemblyName>
    <Product>Tools for Steam</Product>
    <Version>0.4.1-beta.1</Version>
    <AssemblyVersion>0.4.1.0</AssemblyVersion>
    <FileVersion>0.4.1.0</FileVersion>
    <InformationalVersion>0.4.1-beta.1</InformationalVersion>
    <DiscordClientId Condition="'$(DiscordClientId)' == ''">$(TOOLS_FOR_STEAM_DISCORD_CLIENT_ID)</DiscordClientId>
    <DiscordClientId Condition="'$(DiscordClientId)' == ''">1526906410359848990</DiscordClientId>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup Condition="'$(DiscordClientId)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DiscordClientId</_Parameter1>
      <_Parameter2>$(DiscordClientId)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\**\*" Exclude="Assets\splash-boot.png;Assets\splash-steam-icon.png" />
    <SplashScreen Include="Assets\splash-boot.png" />
    <Resource Include="Assets\splash-steam-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AudioSwitcher.AudioApi.CoreAudio" Version="3.0.3" />
    <PackageReference Include="HidSharp" Version="2.6.4" />
    <PackageReference Include="Nefarius.Drivers.HidHide" Version="3.4.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="Viiper.Client" Version="0.7.0" />
    <PackageReference Include="Vortice.DirectInput" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ToolsForSteam.Splash\ToolsForSteam.Splash.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ThirdParty\PawnIO\RyzenSMU.bin" />
    <None Include="ThirdParty\PawnIO\COPYING" CopyToOutputDirectory="PreserveNewest" />
    <None Include="ThirdParty\PawnIO\NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="ThirdParty\DiscordSocialSdk\bin\discord_partner_sdk.dll"
          Link="discord_partner_sdk.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="ThirdParty\DiscordSocialSdk\License-Notices.txt"
          ExcludeFromSingleFile="true"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="ThirdParty\DiscordSocialSdk\NOTICE.txt"
          ExcludeFromSingleFile="true"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="ThirdParty\Legendary\NOTICE.txt"
          ExcludeFromSingleFile="true"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="ThirdParty\EpicLauncherBridge\NOTICE.txt"
          ExcludeFromSingleFile="true"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="ThirdParty\GogDl\NOTICE.txt"
          ExcludeFromSingleFile="true"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="ThirdParty\PlayniteAchievements\NOTICE.txt"
          ExcludeFromSingleFile="true"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="ThirdParty\PlayniteAchievements\LICENSE.txt"
          ExcludeFromSingleFile="true"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="ThirdParty\RetroAchievements\NOTICE.txt"
          ExcludeFromSingleFile="true"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="ThirdParty\TinyNvidiaUpdateChecker\NOTICE.txt"
          ExcludeFromSingleFile="true"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
