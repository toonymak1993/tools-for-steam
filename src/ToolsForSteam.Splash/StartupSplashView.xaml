<UserControl x:Class="ToolsForSteam.Splash.StartupSplashView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#081019"
             IsHitTestVisible="False">
    <Grid ClipToBounds="True">
        <Viewbox Stretch="Fill">
            <ItemsControl Width="1920"
                          Height="1080"
                          ItemsSource="{Binding GameCovers, ElementName=Root}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="12" Rows="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Image Source="{Binding}" Stretch="UniformToFill" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Viewbox>

        <Image Source="{Binding CustomImagePath, ElementName=Root}"
               Stretch="UniformToFill" />

        <Rectangle Fill="#55081019" />
        <Rectangle>
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.5"
                                     GradientOrigin="0.5,0.5"
                                     RadiusX="0.52"
                                     RadiusY="0.52">
                    <GradientStop Color="#D0081019" Offset="0" />
                    <GradientStop Color="#20081019" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="64">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="720">
                <Border Width="180"
                        Height="180"
                        HorizontalAlignment="Center"
                        Background="#0F1823"
                        BorderBrush="#243244"
                        BorderThickness="4"
                        CornerRadius="90"
                        ClipToBounds="True">
                    <Image Source="/ToolsForSteam.Splash;component/Assets/splash-steam-icon.png"
                           Stretch="Uniform"
                           Margin="18" />
                </Border>

                <TextBlock Text="Tools for Steam"
                           Margin="0,28,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#F1F6FB"
                           FontSize="52"
                           FontWeight="Bold" />

                <TextBlock Text="Preparing Steam"
                           Margin="0,18,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#D8E3EE"
                           FontSize="24"
                           FontWeight="SemiBold" />

                <TextBlock Text="{Binding DetailText, ElementName=Root}"
                           Margin="0,14,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#AAB8C6"
                           FontSize="16"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />

                <TextBlock Text="{Binding StateText, ElementName=Root}"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#8091A3"
                           FontSize="14"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,32,0,0">
                    <StackPanel.Triggers>
                        <EventTrigger RoutedEvent="StackPanel.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="Dot1"
                                                     Storyboard.TargetProperty="Opacity"
                                                     From="0.2" To="1.0"
                                                     Duration="0:0:0.45"
                                                     AutoReverse="True"
                                                     BeginTime="0:0:0" />
                                    <DoubleAnimation Storyboard.TargetName="Dot2"
                                                     Storyboard.TargetProperty="Opacity"
                                                     From="0.2" To="1.0"
                                                     Duration="0:0:0.45"
                                                     AutoReverse="True"
                                                     BeginTime="0:0:0.18" />
                                    <DoubleAnimation Storyboard.TargetName="Dot3"
                                                     Storyboard.TargetProperty="Opacity"
                                                     From="0.2" To="1.0"
                                                     Duration="0:0:0.45"
                                                     AutoReverse="True"
                                                     BeginTime="0:0:0.36" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </StackPanel.Triggers>
                    <Ellipse x:Name="Dot1" Width="9" Height="9" Fill="#6A93B5" Margin="7,0" Opacity="0.2" />
                    <Ellipse x:Name="Dot2" Width="9" Height="9" Fill="#6A93B5" Margin="7,0" Opacity="0.2" />
                    <Ellipse x:Name="Dot3" Width="9" Height="9" Fill="#6A93B5" Margin="7,0" Opacity="0.2" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
