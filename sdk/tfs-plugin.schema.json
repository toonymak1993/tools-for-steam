{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toolsforsteam.dev/schemas/tfs-plugin.schema.json",
  "title": "Tools for Steam Plugin Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "name",
    "version",
    "sdkVersion",
    "entryPoint",
    "permissions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable community plugin id. Must match the catalog entry id.",
      "pattern": "^[a-z0-9][a-z0-9._-]*[a-z0-9]$"
    },
    "name": {
      "type": "string",
      "description": "Human-readable plugin name shown by TFS.",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "description": "Package version. Must match the catalog entry version.",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "description": "Optional short plugin description shown by the runtime loader."
    },
    "sdkVersion": {
      "type": "string",
      "description": "Tools for Steam Plugin SDK feature level required by this plugin.",
      "const": "1.0.0"
    },
    "entryPoint": {
      "type": "string",
      "description": "Relative JavaScript entry point inside the package.",
      "pattern": "^[^/\\\\.][^\\\\]*\\.m?js$"
    },
    "permissions": {
      "type": "array",
      "description": "Declared SDK capabilities, including optional native TFS bridges.",
      "items": {
        "type": "string",
        "enum": [
          "frontend",
          "storage",
          "secrets",
          "network",
          "files",
          "notifications",
          "logging",
          "native.audio",
          "native.processes",
          "native.display",
          "native.themes",
          "native.artwork",
          "native.app-start",
          "native.store-sync",
          "native.automation",
          "native.performance",
          "native.power",
          "native.full-trust"
        ],
        "pattern": "^[a-z0-9][a-z0-9._-]*$",
        "examples": [
          "frontend",
          "storage",
          "secrets",
          "network",
          "files",
          "notifications",
          "logging",
          "native.audio",
          "native.processes",
          "native.display",
          "native.themes",
          "native.artwork",
          "native.app-start",
          "native.store-sync",
          "native.automation",
          "native.performance",
          "native.power",
          "native.full-trust"
        ]
      },
      "uniqueItems": true
    },
    "networkHosts": {
      "type": "array",
      "description": "Exact hosts or leading wildcard domains available to sdk.network. Use <local> only for LAN integrations.",
      "items": {
        "type": "string",
        "pattern": "^(<local>|(\\*\\.)?[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?)$"
      },
      "uniqueItems": true
    },
    "backend": {
      "type": "object",
      "description": "Optional trusted native backend launched and managed by TFS.",
      "required": ["entryPoint"],
      "properties": {
        "entryPoint": { "type": "string", "minLength": 1 },
        "runtime": { "enum": ["executable", "powershell", "python", "node"] },
        "runtimeExecutable": { "type": "string" },
        "arguments": { "type": "array", "items": { "type": "string" } },
        "environment": { "type": "object", "additionalProperties": { "type": "string" } },
        "secretEnvironment": { "type": "object", "additionalProperties": { "type": "string" } },
        "autoStart": { "type": "boolean" },
        "createNoWindow": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "permissions": {
            "contains": { "const": "network" }
          }
        },
        "required": ["permissions"]
      },
      "then": {
        "required": ["networkHosts"],
        "properties": {
          "networkHosts": { "minItems": 1 }
        }
      }
    },
    {
      "if": { "required": ["backend"] },
      "then": {
        "properties": {
          "permissions": { "contains": { "const": "native.full-trust" } }
        }
      }
    }
  ]
}
